// ============================================================
// SHARED BITS
// ============================================================
function Barbell({ plateCount, color, size = 'md' }) {
  const big = size === 'lg'
  const w = big ? 300 : 132
  const h = big ? 92 : 52
  const cx = w / 2
  const plateH = [0.5, 0.72, 0.94]
  const plateW = big ? 15 : 8
  const gap = big ? 20 : 11
  const barH = big ? 8 : 5
  const off = big ? 26 : 15
  const plate = (i, sign) => {
    const filled = i < plateCount
    const x = cx + sign * (off + i * (plateW + gap))
    const ph = h * plateH[i]
    return (
      <rect
        key={`${sign}-${i}`}
        x={sign > 0 ? x : x - plateW}
        y={(h - ph) / 2}
        width={plateW}
        height={ph}
        rx={2}
        fill={filled ? color : '#221D33'}
        stroke={filled ? color : '#2E2842'}
        strokeWidth="1"
        opacity={filled ? 1 : 0.7}
      />
    )
  }
  return (
    <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`} role="img" aria-label={`${plateCount} of 3 plates loaded`}>
      <rect x={cx - (off + 2)} y={(h - barH) / 2} width={2 * (off + 2)} height={barH} rx={barH / 2} fill="#4A4464" />
      <circle cx={cx} cy={h / 2} r={big ? 6 : 4} fill="#6B6488" />
      {[0, 1, 2].map(i => plate(i, 1))}
      {[0, 1, 2].map(i => plate(i, -1))}
    </svg>
  )
}

function ScreenHeader({ label, onBack, color, back = 'The Arena' }) {
  return (
    <div className="screen-header" style={{ borderBottom: `1px solid ${color}44` }}>
      <button className="back-btn" onClick={onBack}>← {back}</button>
      <div className="screen-header-title" style={{ color }}>{label}</div>
    </div>
  )
}

// ============================================================
// FRONTDOOR — the TR greeter splash (arena-main-splash.html)
// ============================================================
function Frontdoor({ onEnter }) {
  return (
    <div className="stage">
      <div className="toprule" />
      <img className="tr" src="/images/arena/tr-greeter.png" alt="Theodore Roosevelt standing at the entrance of The Arena" />
      <div className="fd-wrap">
        <div className="brand">
          <img className="badge" src="/images/arena/badge.png" alt="" />
          <div className="brand-txt">
            <div className="eyebrow">Flashpoint History</div>
            <h1>The Arena</h1>
          </div>
        </div>
        <blockquote className="quote">
          <p>&ldquo;{ARENA_QUOTE.text}&rdquo;</p>
          <cite>{ARENA_QUOTE.cite}</cite>
        </blockquote>
        <p className="purpose">
          This is where you train the exact skills the Regents tests — on your own time, at your own pace. Not a replacement for class. A place to get stronger between the bells.
        </p>
        <div className="how">
          <div className="how-h">How to use this place</div>
          <div className="step"><div className="step-n">1</div><div className="step-t">Start in <b>the Circuit</b> — pick a skill, take a rep, load a plate.</div></div>
          <div className="step"><div className="step-n">2</div><div className="step-t">Stuck mid-essay? Duck into the <b>Trainer&rsquo;s Room</b> for tools.</div></div>
          <div className="step"><div className="step-n">3</div><div className="step-t">After a test, hit the <b>Recovery Room</b> — five reps and your Comeback Sheet.</div></div>
        </div>
        <button className="cta" onClick={onEnter}>Enter the Arena <span className="a">&rarr;</span></button>
      </div>
      <div className="foot">Train here. Perform anywhere.</div>
    </div>
  )
}

// ============================================================
// ROOMS — the picker (arena-landing-splash.html)
// ============================================================
const ROOMS = [
  { key: 'circuit',  name: 'The Circuit',     ac: '#E8960A', head: 'Train the skills', line: '12 stations, four tiers. Load a plate for every rep you own.', cta: 'Enter the Circuit',
    icon: (<g stroke="currentColor" strokeWidth="2.4" fill="none" strokeLinecap="round"><line x1="15" y1="24" x2="33" y2="24"/><rect x="7" y="16" width="5" height="16" rx="2"/><rect x="12.5" y="19" width="3.5" height="10" rx="1.6"/><rect x="36" y="16" width="5" height="16" rx="2"/><rect x="32" y="19" width="3.5" height="10" rx="1.6"/></g>) },
  { key: 'trainers', name: "Trainer's Room",  ac: '#B07CD0', head: 'Grab your tools', line: '7 quick references for when you’re stuck mid-essay.', cta: 'Open the Trainer’s Room',
    icon: (<g stroke="currentColor" strokeWidth="2.4" fill="none" strokeLinecap="round" strokeLinejoin="round"><rect x="12" y="11" width="24" height="29" rx="3"/><rect x="19" y="8" width="10" height="6" rx="2"/><line x1="17" y1="23" x2="31" y2="23"/><line x1="17" y1="29" x2="31" y2="29"/><line x1="17" y1="35" x2="26" y2="35"/></g>) },
  { key: 'recovery', name: 'Recovery Room',   ac: '#43D982', head: 'Bounce back', line: 'After a test: 5 fast reps and your Comeback Sheet for points back.', cta: 'Enter Recovery',
    icon: (<g stroke="currentColor" strokeWidth="2.4" fill="none" strokeLinecap="round"><rect x="9" y="9" width="30" height="30" rx="9"/><line x1="24" y1="17" x2="24" y2="31"/><line x1="17" y1="24" x2="31" y2="24"/></g>) },
]

function Rooms({ onPick, onBack }) {
  return (
    <div className="hero">
      <div className="toprule" />
      <div className="rooms-head">
        <div className="eyebrow">Flashpoint History</div>
        <h1 className="wordmark">The Arena</h1>
        <div className="rule" />
        <div className="subtitle">Train here. Perform anywhere.</div>
        <div className="prompt">Pick your room.</div>
      </div>
      <div className="rooms">
        {ROOMS.map((r, i) => (
          <button key={r.key} className="room" style={{ '--ac': r.ac, animationDelay: `${0.15 + i * 0.08}s` }} onClick={() => onPick(r.key)} aria-label={r.cta}>
            <span className="room-bar" />
            <span className="room-icon"><svg viewBox="0 0 48 48" aria-hidden="true">{r.icon}</svg></span>
            <span className="room-name">{r.name}</span>
            <span className="room-head">{r.head}</span>
            <span className="room-line">{r.line}</span>
            <span className="room-cta">{r.cta} <span className="arw">&rarr;</span></span>
          </button>
        ))}
      </div>
      <div className="rooms-foot">
        <button className="text-link" onClick={onBack}>← Front door</button>
        <span>The gym is open.</span>
        <a className="text-link" href={HOME_URL}>Flashpoint Timeline ↩</a>
      </div>
    </div>
  )
}

// ============================================================
// THE CIRCUIT — 12 stations + skill filter
// ============================================================
function Circuit({ progress, onOpen, onBack }) {
  const [filter, setFilter] = useState(0) // 0 = all; else a skill id
  const shown = filter === 0 ? STATIONS : STATIONS.filter(s => s.skillTags.includes(filter))
  return (
    <div className="wrap">
      <ScreenHeader label="The Circuit" onBack={onBack} color="#E8960A" back="Rooms" />
      <div className="circuit-intro">
        <h2 style={{ color: '#E8960A' }}>The Circuit</h2>
        <p>Twelve stations, four tiers. Pick a skill to filter, take the rep, load a plate for every move you own. Nothing here is graded — the plates are yours to earn.</p>
        <div className="filter-row">
          <button className={`chip${filter === 0 ? ' on' : ''}`} onClick={() => setFilter(0)}>All skills</button>
          {Object.entries(SKILLS).map(([id, label]) => (
            <button key={id} className={`chip${filter === +id ? ' on' : ''}`} onClick={() => setFilter(+id)}>
              {id} · {label}
            </button>
          ))}
        </div>
      </div>
      <div className="station-grid">
        {shown.map(st => {
          const saved = progress[st.id] || { mastery: [false, false, false] }
          const plateCount = saved.mastery.filter(Boolean).length
          const tier = TIERS[st.tier]
          return (
            <button key={st.id} className="station-card" style={{ '--ac': st.color }} onClick={() => onOpen(st.id)}>
              <span className="station-card-bar" />
              <div className="station-card-top">
                <span className="station-card-num">Station {st.num}</span>
                <span className="tier-badge" style={{ color: tier.color, background: `${tier.color}18`, border: `1px solid ${tier.color}44` }}>{tier.label}</span>
              </div>
              <div className="station-card-name">{st.name}</div>
              <div className="station-card-tagline">{st.tagline}</div>
              <div className="station-card-skills">
                {st.skillTags.length
                  ? st.skillTags.map(t => <span key={t} className="skill-pill">{SKILLS[t]}</span>)
                  : <span className="skill-pill meta">Meta</span>}
              </div>
              <div className="station-card-foot">
                <Barbell plateCount={plateCount} color={st.color} size="md" />
                <span className="plate-count">{plateCount}/3</span>
              </div>
              {st.pending && <span className="pending-flag">Regents drill loads on audit</span>}
            </button>
          )
        })}
      </div>
    </div>
  )
}

// ============================================================
// STATION — StationScreen.v1.1 (multi-attempt compare mechanic)
// Adapted from assets/arena/StationScreen.v1.1.jsx: props unchanged; added a
// stimulus render (images-first, from the bound package) and a `pending` note
// for stations whose Regents drill has not yet been audited in.
// ============================================================
function Stimulus({ items, accent }) {
  if (!items || !items.length) return null
  return (
    <div className="stimulus-block">
      {items.map((doc, i) => (
        <figure className="stimulus" key={i} style={{ borderColor: `${accent}33` }}>
          {doc.image_ref && (
            <img src={`/content/${doc.image_ref}`} alt={doc.image_alt || ''} loading="lazy" />
          )}
          {doc.content && (
            <details className="stimulus-text">
              <summary>Read the transcription</summary>
              <p>{doc.content}</p>
            </details>
          )}
          {doc.citation && <figcaption>{doc.citation}</figcaption>}
        </figure>
      ))}
    </div>
  )
}

function StationScreen({ stationId, progress, onUpdateProgress, onBack }) {
  const station = STATIONS.find(s => s.id === stationId)
  if (!station) return null

  const [attempt1, setAttempt1] = useState('')
  const [attempt2, setAttempt2] = useState('')
  const [revealed, setRevealed] = useState(false)
  const [comparing, setComparing] = useState(false)

  const saved = progress[stationId] || { mastery: [false, false, false] }
  const mastery = saved.mastery
  const plateCount = mastery.filter(Boolean).length
  const prAchieved = plateCount === 3
  const tierInfo = TIERS[station.tier]

  const canReveal = attempt1.trim().length >= 40

  const toggle = (i) => {
    const next = [...mastery]
    next[i] = !next[i]
    onUpdateProgress(stationId, next)
  }

  return (
    <div className="wrap">
      <ScreenHeader label={`Station ${station.num}`} onBack={onBack} color={station.color} back="The Circuit" />
      <div className="station-screen">
        <div className="station-hero">
          <span className="station-tier-badge" style={{ color: tierInfo.color, background: `${tierInfo.color}18`, border: `1px solid ${tierInfo.color}44` }}>
            {tierInfo.label}
          </span>
          <div className="station-screen-num">Station {station.num}</div>
          <div className="station-screen-name">{station.name}</div>
          <div className="station-screen-tagline">{station.tagline}</div>
        </div>

        <div className="station-barbell-section">
          <Barbell plateCount={plateCount} color={station.color} size="lg" />
          <div className="barbell-label-row">
            {station.plates.map((pl, i) => (
              <span key={i} className="barbell-label" style={{ color: i < plateCount ? station.color : '#4A4464' }}>{pl}</span>
            ))}
          </div>
          {prAchieved && (
            <>
              <div className="pr-rule" style={{ marginTop: 20 }} />
              <div className="pr-title" style={{ color: station.color }}>THIS WEIGHT IS YOURS</div>
            </>
          )}
        </div>

        <div className="station-intro">
          {station.intro.map((p, i) => <p key={i}>{p}</p>)}
        </div>

        <div className="everyday-box">
          <div className="everyday-label">{station.everyday.label}</div>
          <div className="everyday-text">{station.everyday.text}</div>
        </div>

        <div className="beats-section">
          <div className="beats-title">The Moves</div>
          {station.beats.map((beat, i) => (
            <div className="beat-card" key={i}>
              <div className="beat-move" style={{ color: station.color }}>{beat.move}</div>
              <div className="beat-desc">{beat.desc}</div>
            </div>
          ))}
        </div>

        {/* ── THE REP — multi-attempt compare ── */}
        <div className="practice-section">
          <div className="practice-label">Your Rep</div>
          {station.pending
            ? <div className="rep-kind">Rep 1 · Everyday on-ramp — the Regents drill for this unit loads when its package is audited.</div>
            : <div className="rep-kind on">Rep {station.repNum || 2} · Regents rep — bound from the audited package.</div>}
          <div className="practice-prompt">{station.practice.prompt}</div>
          <Stimulus items={station.stimulus} accent={station.color} />

          {!comparing ? (
            <>
              <div className="attempt-label" style={{ color: station.color }}>Attempt 1</div>
              <div className="practice-hint">Aim for 3–5 sentences. Take a real swing — the model stays locked until you do.</div>
              <textarea className="practice-textarea" placeholder="Write your response here..." value={attempt1} onChange={e => setAttempt1(e.target.value)} />

              {!revealed ? (
                <div style={{ marginTop: 14 }}>
                  <button className="arena-btn-primary" disabled={!canReveal} onClick={() => setRevealed(true)}>Reveal the model →</button>
                  {!canReveal && <div className="reveal-hint">Write your attempt first. There are no shortcuts in the Arena.</div>}
                </div>
              ) : (
                <>
                  <div className="exemplar-box" style={{ marginTop: 20 }}>
                    <div className="exemplar-header">Model Response</div>
                    <div className="exemplar-text">{station.exemplar}</div>
                  </div>
                  <div className="compare-focus">
                    <div className="compare-focus-label">One move to sharpen</div>
                    <div className="compare-focus-text">{station.examConnection.missedMove}</div>
                  </div>
                  <div style={{ marginTop: 6 }}>
                    <button className="arena-btn-primary" onClick={() => setComparing(true)}>Go again — Attempt 2 →</button>
                    <div className="reveal-hint">Don&rsquo;t copy the model. Take your own answer again and add the one move above.</div>
                  </div>
                </>
              )}
            </>
          ) : (
            <>
              <div className="compare-grid">
                <div>
                  <div className="attempt-label">Attempt 1</div>
                  <div className="attempt-readonly">{attempt1}</div>
                </div>
                <div>
                  <div className="attempt-label" style={{ color: station.color }}>Attempt 2</div>
                  <textarea className="practice-textarea" style={{ minHeight: 160 }} placeholder="Write it again — sharper this time..." value={attempt2} onChange={e => setAttempt2(e.target.value)} />
                </div>
              </div>
              <div className="compare-focus">
                <div className="compare-focus-label">The one move you&rsquo;re adding</div>
                <div className="compare-focus-text">{station.examConnection.missedMove}</div>
              </div>
              <div className="exemplar-box">
                <div className="exemplar-header">Model Response</div>
                <div className="exemplar-text">{station.exemplar}</div>
                <div className="exemplar-note">Attempt 1, Attempt 2, and the model are all in front of you. Read them together and find the gap that&rsquo;s closing — that gap is the rep.</div>
              </div>
            </>
          )}
        </div>

        <div className="mastery-section">
          <div className="mastery-title">Check Your Work</div>
          {station.mastery.map((item, i) => (
            <div className="mastery-item" key={i} onClick={() => toggle(i)}>
              <div className={`mastery-checkbox${mastery[i] ? ' checked' : ''}`} style={mastery[i] ? { borderColor: station.color, background: `${station.color}33` } : {}}>
                {mastery[i] && <span className="mastery-check-icon" style={{ color: station.color }}>✓</span>}
              </div>
              <div className={`mastery-text${mastery[i] ? ' done' : ''}`}>{item}</div>
            </div>
          ))}
        </div>

        <div className="exam-connection">
          <div className="exam-connection-label">Exam Connection</div>
          <div className="exam-row"><div className="exam-key">Exam</div><div className="exam-val">{station.examConnection.exam}</div></div>
          <div className="exam-row"><div className="exam-key">Where</div><div className="exam-val">{station.examConnection.where}</div></div>
          <div className="exam-row"><div className="exam-key">Scorer looks for</div><div className="exam-val">{station.examConnection.lookFor}</div></div>
          <div className="exam-missed">
            <div className="exam-missed-label">Most Missed Move</div>
            <div className="exam-missed-text">{station.examConnection.missedMove}</div>
          </div>
        </div>

        {prAchieved && (
          <div className="pr-section">
            <div className="pr-rule" />
            <div className="pr-title" style={{ color: station.color }}>THIS WEIGHT IS YOURS</div>
            <div className="pr-sub">Station {station.num} complete. The gym is always open — come back any time.</div>
          </div>
        )}
      </div>
    </div>
  )
}

// ============================================================
// TRAINER'S ROOM — 7 quick-reference tools (the fix: "6 tools" → "7 tools")
// ============================================================
const TOOLS = [
  { name: 'The 4-Question Source Frame', line: 'Sourcing on demand: Who made it? When? For whom? Why?', model: 'Ask in order — origin, date, audience, purpose — before you trust a word of it.' },
  { name: 'Thesis Formula', line: 'A claim someone could argue against.', model: '"[Position] because [reason A], [reason B], and [reason C]" — a stance with a roadmap.' },
  { name: 'PEEL Paragraph Builder', line: 'Point · Evidence · Explain · Link.', model: 'Never skip the Link: the sentence that says why the evidence proves the point.' },
  { name: 'Causation Connectives', line: 'The words that make a cause visible.', model: 'because · led to · resulted in · as a consequence · which caused' },
  { name: 'Contextualization Starters', line: 'The "before this…" sentence.', model: '"In the years before this, ___ was already true, which is why ___ happened."' },
  { name: 'Rubric Translator', line: 'What the scorer is actually counting.', model: 'Turns rubric-speak ("analyze," "evaluate") into the concrete move that earns the point.' },
  { name: 'Outside Evidence Bank', line: 'The stuff you already know.', model: 'Name a fact NOT in the documents that backs your claim — the move that lifts a 3 to a 4.' },
]

function Trainers({ onBack }) {
  return (
    <div className="wrap">
      <ScreenHeader label="Trainer's Room" onBack={onBack} color="#B07CD0" back="Rooms" />
      <div className="circuit-intro">
        <h2 style={{ color: '#B07CD0' }}>Trainer&rsquo;s Room</h2>
        <p><b>7 tools</b> for when you&rsquo;re stuck mid-essay. Quick references — complete model sentences, never fill-in-the-blank. Grab one and get back in.</p>
      </div>
      <div className="tools-grid">
        {TOOLS.map((t, i) => (
          <div className="tool-card" key={i} style={{ '--ac': '#B07CD0' }}>
            <div className="tool-num">Tool {i + 1} of 7</div>
            <div className="tool-name">{t.name}</div>
            <div className="tool-line">{t.line}</div>
            <div className="tool-model">{t.model}</div>
          </div>
        ))}
      </div>
    </div>
  )
}

// ============================================================
// RECOVERY ROOM — stateless click-to-check mc_set trainer
// Reads mc_set packages BY REFERENCE (arena-mcset-schema-amendment.md). None
// are audited in yet → clean empty state. Drop an mcset-*.json into src/content/
// and it appears here automatically.
// ============================================================
const MCSET_MODULES = import.meta.glob('./content/mcset-*.json', { eager: true })
const MC_PACKS = Object.values(MCSET_MODULES)
  .map(m => m.default || m)
  .filter(p => p && p.package_type === 'mc_set')
  .sort((a, b) => (a.unit?.id || '').localeCompare(b.unit?.id || ''))

function McItem({ item }) {
  const [picked, setPicked] = useState(null)
  const answered = picked != null
  return (
    <div className="mc-item">
      {item.stimulus && (
        <figure className="stimulus">
          {item.stimulus.image_ref && <img src={`/content/${item.stimulus.image_ref}`} alt={item.stimulus.image_alt || ''} loading="lazy" />}
          {item.stimulus.content && (
            <details className="stimulus-text"><summary>Read the transcription</summary><p>{item.stimulus.content}</p></details>
          )}
          {item.stimulus.citation && <figcaption>{item.stimulus.citation}</figcaption>}
        </figure>
      )}
      <div className="mc-q">{item.n}. {item.question}</div>
      {item.choices.map(c => {
        let cls = 'mc-choice'
        if (answered) {
          if (c.key === item.correct) cls += ' correct'
          else if (c.key === picked) cls += ' incorrect'
          else cls += ' dim'
        }
        return (
          <button key={c.key} className={cls} disabled={answered} onClick={() => setPicked(c.key)}>
            <b>{c.key}.</b> {c.text}
          </button>
        )
      })}
      {answered && (
        <div className="mc-reveal">
          <div className={picked === item.correct ? 'mc-verdict ok' : 'mc-verdict no'}>
            {picked === item.correct ? '✓ Correct' : '✗ Review'}
          </div>
          <p className="mc-reasoning">{item.reasoning}</p>
          {item.evidence_line && <p className="mc-evidence"><b>Evidence line:</b> {item.evidence_line}</p>}
          {picked !== item.correct && item.distractors?.[picked] && (
            <p className="mc-distractor"><b>Why that one tempts:</b> {item.distractors[picked]}</p>
          )}
        </div>
      )}
    </div>
  )
}

function Recovery({ onBack }) {
  const [packId, setPackId] = useState(MC_PACKS[0]?.unit?.id || null)
  const pack = MC_PACKS.find(p => p.unit?.id === packId) || null
  return (
    <div className="wrap">
      <ScreenHeader label="Recovery Room" onBack={onBack} color="#43D982" back="Rooms" />
      <div className="circuit-intro">
        <h2 style={{ color: '#43D982' }}>Recovery Room</h2>
        <p>After a test: five fast reps to win points back, click-to-check, no score kept. Miss one and it teaches you why. Then copy the evidence line onto your Comeback Sheet in your own hand.</p>
      </div>

      {MC_PACKS.length === 0 ? (
        <div className="empty-state">
          <div className="empty-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="48" height="48"><g stroke="#43D982" strokeWidth="2.2" fill="none" strokeLinecap="round"><rect x="9" y="9" width="30" height="30" rx="9"/><line x1="24" y1="17" x2="24" y2="31"/><line x1="17" y1="24" x2="31" y2="24"/></g></svg>
          </div>
          <div className="empty-title">The Recovery Room is warming up</div>
          <p className="empty-text">Packs load here as each unit is audited. The moment a unit&rsquo;s <code>mc_set</code> package drops into <code>/content</code>, its five reps appear here — five per unit, 11.1 through 11.11.</p>
          <p className="empty-sub">Nothing to do here yet is the honest answer. Head to the Circuit and train a skill in the meantime.</p>
        </div>
      ) : (
        <>
          <div className="pack-row">
            {MC_PACKS.map(p => (
              <button key={p.unit.id} className={`chip${p.unit.id === packId ? ' on' : ''}`} onClick={() => setPackId(p.unit.id)}>
                {p.unit.id} · {p.unit.title}
              </button>
            ))}
          </div>
          {pack && (
            <div className="mc-list">
              {pack.items.map(it => <McItem key={it.n} item={it} />)}
            </div>
          )}
        </>
      )}
    </div>
  )
}

// ============================================================
// APP CONTROLLER
// ============================================================
const PROGRESS_KEY = 'arena_progress_v1'

export default function App() {
  const [screen, setScreen] = useState('frontdoor') // frontdoor | rooms | circuit | station | trainers | recovery
  const [stationId, setStationId] = useState(null)

  // progress = { [stationId]: { mastery: [bool,bool,bool] } } — enriches, never gates.
  const [progress, setProgress] = useState(() => {
    try { return JSON.parse(localStorage.getItem(PROGRESS_KEY) || '{}') } catch { return {} }
  })

  function updateProgress(id, mastery) {
    setProgress(prev => {
      const next = { ...prev, [id]: { mastery } }
      try { localStorage.setItem(PROGRESS_KEY, JSON.stringify(next)) } catch { /* wiped device still works */ }
      return next
    })
  }

  const openStation = (id) => { setStationId(id); setScreen('station') }

  return (
    <div className="arena-root">
      <style>{CSS}</style>
      {screen === 'frontdoor' && <Frontdoor onEnter={() => setScreen('rooms')} />}
      {screen === 'rooms' && <Rooms onPick={setScreen} onBack={() => setScreen('frontdoor')} />}
      {screen === 'circuit' && <Circuit progress={progress} onOpen={openStation} onBack={() => setScreen('rooms')} />}
      {screen === 'station' && <StationScreen stationId={stationId} progress={progress} onUpdateProgress={updateProgress} onBack={() => setScreen('circuit')} />}
      {screen === 'trainers' && <Trainers onBack={() => setScreen('rooms')} />}
      {screen === 'recovery' && <Recovery onBack={() => setScreen('rooms')} />}
    </div>
  )
}

// ============================================================
// CSS — injected once. :root swaps the prototype canvas (#0D0B14) for the
// SHARED Flashpoint ink (#16120E); Barlow Condensed / Outfit + amber kept.
// ============================================================
const CSS = `
:root{
  --bg:#16120E;            /* SHARED Flashpoint canvas (was #0D0B14) */
  --panel:#1C1712;
  --amber:#C17700; --amber2:#E8960A;
  --white:#F2EFE8; --dim:#B4AEC6; --dimmer:#8E88A0;
  --border:#2E2820; --border2:#3A3226;
  --bg2:#120E0A;
  --fd:'Barlow Condensed',sans-serif; --fb:'Outfit',sans-serif;
  --font-display:var(--fd);
}
.arena-root{min-height:100svh;background:var(--bg);color:var(--white);font-family:var(--fb)}

/* ── shared header / buttons ── */
.wrap{max-width:920px;margin:0 auto;padding:0 22px 100px}
.screen-header{position:sticky;top:0;z-index:10;background:rgba(22,18,14,.92);backdrop-filter:blur(6px);
  display:flex;align-items:center;gap:16px;padding:16px 0;margin-bottom:8px}
.back-btn{background:none;border:none;color:var(--dim);font-family:var(--fd);font-weight:600;letter-spacing:.06em;
  text-transform:uppercase;font-size:14px;cursor:pointer;padding:6px 2px}
.back-btn:hover{color:var(--white)}
.screen-header-title{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.04em;font-size:22px;margin-left:auto}
.arena-btn-primary{background:var(--amber);color:var(--bg);border:none;border-radius:4px;font-family:var(--fd);
  font-size:14px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:12px 24px;cursor:pointer;transition:all .2s}
.arena-btn-primary:hover:not(:disabled){background:var(--amber2)}
.arena-btn-primary:disabled{opacity:.4;cursor:not-allowed}
.arena-btn-primary:focus-visible{outline:2px solid var(--amber2);outline-offset:2px}

/* ── FRONTDOOR (arena-main-splash) ── */
.stage{position:relative;min-height:100svh;display:flex;align-items:stretch;overflow:hidden;isolation:isolate;
 background:linear-gradient(90deg, rgba(22,18,14,.62) 0%, rgba(22,18,14,.34) 34%, rgba(22,18,14,.66) 62%, rgba(22,18,14,.92) 100%),
  linear-gradient(180deg, rgba(22,18,14,.5), rgba(22,18,14,.5)),
  url("/images/arena/frontdoor-bg.jpg") center/cover no-repeat;}
.toprule{position:absolute;top:0;left:0;right:0;height:3px;z-index:5;background:linear-gradient(90deg,transparent,var(--amber),var(--amber),transparent)}
.tr{position:absolute;bottom:0;left:-2%;height:94vh;max-height:1000px;z-index:1;pointer-events:none;
 filter:drop-shadow(0 12px 40px rgba(0,0,0,.6));animation:trin 1s .1s both cubic-bezier(.2,.7,.2,1)}
@keyframes trin{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:none}}
.fd-wrap{margin-left:auto;width:min(560px,50%);z-index:2;display:flex;flex-direction:column;justify-content:center;gap:20px;
 padding:48px 56px;background:linear-gradient(90deg, transparent, rgba(15,12,9,.55) 16%, rgba(15,12,9,.82));animation:up .8s .2s both cubic-bezier(.2,.7,.2,1)}
@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.brand{display:flex;align-items:center;gap:16px}
.badge{width:64px;height:64px;border-radius:50%;border:2px solid var(--amber);flex:none;box-shadow:0 0 24px rgba(193,119,0,.35)}
.brand-txt .eyebrow{font-family:var(--fd);font-size:12px;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:var(--amber2)}
.brand-txt h1{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.02em;line-height:.85;font-size:clamp(46px,6vw,68px)}
.quote{border-left:2px solid var(--amber);padding-left:18px}
.quote p{font-size:17px;line-height:1.6;font-style:italic;color:rgba(242,239,232,.9)}
.quote cite{display:block;margin-top:8px;font-family:var(--fd);font-style:normal;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--amber2)}
.purpose{font-size:16px;line-height:1.6;color:rgba(242,239,232,.82)}
.how{border-top:1px solid var(--border);padding-top:18px}
.how-h{font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:12px}
.step{display:flex;gap:13px;align-items:flex-start;margin-bottom:11px}
.step-n{font-family:var(--fd);font-weight:900;font-size:15px;color:var(--amber);flex:none;width:20px;line-height:1.5}
.step-t{font-size:14.5px;line-height:1.5;color:rgba(242,239,232,.84)}
.step-t b{color:var(--white);font-weight:600}
.cta{margin-top:8px;display:inline-flex;align-items:center;gap:10px;align-self:flex-start;background:var(--amber);color:#120d05;border:none;border-radius:6px;cursor:pointer;
 font-family:var(--fd);font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:17px;padding:15px 30px;transition:all .2s}
.cta:hover{background:var(--amber2)}.cta .a{transition:transform .2s}.cta:hover .a{transform:translateX(5px)}
.cta:focus-visible{outline:2px solid var(--amber2);outline-offset:3px}
.foot{position:absolute;bottom:16px;left:24px;z-index:3;font-family:var(--fd);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(242,239,232,.45)}
@media(max-width:860px){
 .stage{flex-direction:column}
 .tr{height:52vh;left:auto;right:-8%;opacity:.32;filter:grayscale(1) drop-shadow(0 0 20px #000)}
 .fd-wrap{width:100%;margin:auto 0 0;padding:34px 22px 60px;background:linear-gradient(180deg, transparent, rgba(15,12,9,.72) 22%, rgba(15,12,9,.94))}
 .badge{width:54px;height:54px}
 .foot{display:none}
}

/* ── ROOMS (arena-landing-splash) ── */
.hero{min-height:100svh;display:flex;flex-direction:column;position:relative;isolation:isolate;
  background:
   radial-gradient(120% 85% at 50% 26%, transparent 42%, rgba(22,18,14,.55) 100%),
   linear-gradient(180deg, rgba(22,18,14,.86) 0%, rgba(22,18,14,.44) 40%, rgba(22,18,14,.93) 100%),
   url("/images/arena/rooms-bg.jpg") center/cover no-repeat;}
.rooms-head{text-align:center;padding:min(9vh,72px) 20px 0}
.rooms-head .eyebrow{font-family:var(--fd);font-size:13px;font-weight:600;letter-spacing:.32em;text-transform:uppercase;color:var(--amber2)}
.wordmark{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.01em;line-height:.86;font-size:clamp(58px,13vw,132px);margin:6px 0 0;text-shadow:0 2px 40px rgba(0,0,0,.6)}
.rule{width:60px;height:2px;background:var(--amber);margin:18px auto 16px}
.subtitle{font-family:var(--fd);font-size:clamp(15px,2.4vw,20px);font-weight:400;letter-spacing:.18em;text-transform:uppercase;color:rgba(242,239,232,.82)}
.prompt{font-family:var(--fb);font-size:15px;color:var(--dim);margin-top:22px}
.rooms{flex:1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-content:center;width:100%;max-width:1080px;margin:0 auto;padding:32px 22px min(6vh,48px)}
.room{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:2px;cursor:pointer;text-align:left;
  background:linear-gradient(180deg, rgba(30,24,18,.92), rgba(20,15,10,.94));border:1px solid var(--border);border-radius:12px;padding:26px 24px 22px;color:var(--white);font-family:var(--fb);
  overflow:hidden;transition:transform .22s cubic-bezier(.2,.7,.2,1),border-color .22s,box-shadow .22s;box-shadow:0 10px 30px rgba(0,0,0,.35);animation:rise .5s both cubic-bezier(.2,.7,.2,1)}
@keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
.room-bar{position:absolute;top:0;left:0;right:0;height:4px;background:var(--ac);opacity:.9}
.room-icon{width:44px;height:44px;color:var(--ac);margin-bottom:14px}.room-icon svg{width:100%;height:100%}
.room-name{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.02em;font-size:clamp(26px,3.4vw,32px);line-height:1}
.room-head{font-size:16px;font-weight:600;color:var(--white);margin-top:8px}
.room-line{font-size:14px;line-height:1.55;color:var(--dim);margin-top:6px;min-height:44px}
.room-cta{font-family:var(--fd);font-weight:700;letter-spacing:.05em;text-transform:uppercase;font-size:14px;color:var(--ac);margin-top:18px;display:inline-flex;align-items:center;gap:8px}
.arw{transition:transform .22s}
.room:hover,.room:focus-visible{transform:translateY(-7px);border-color:var(--ac);box-shadow:0 18px 44px rgba(0,0,0,.5), 0 0 0 1px var(--ac);outline:none}
.room:hover .arw,.room:focus-visible .arw{transform:translateX(5px)}
.rooms-foot{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:0 24px min(5vh,34px);font-family:var(--fd);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:rgba(242,239,232,.4)}
.text-link{background:none;border:none;color:var(--amber2);font-family:var(--fd);letter-spacing:.14em;text-transform:uppercase;font-size:12px;cursor:pointer;text-decoration:none}
.text-link:hover{color:var(--white)}
@media (max-width:820px){.rooms{grid-template-columns:1fr;gap:14px;max-width:520px}.room-line{min-height:0}.room{padding:22px 20px}}

/* ── CIRCUIT / TRAINERS / RECOVERY shared intro ── */
.circuit-intro{padding:14px 0 6px}
.circuit-intro h2{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.02em;font-size:clamp(30px,5vw,46px);line-height:1}
.circuit-intro p{color:var(--dim);font-size:15.5px;line-height:1.6;margin-top:10px;max-width:640px}
.circuit-intro p b{color:var(--white)}
.filter-row,.pack-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.chip{background:var(--panel);border:1px solid var(--border2);border-radius:20px;color:var(--dim);font-family:var(--fd);font-weight:600;letter-spacing:.03em;font-size:13px;padding:7px 14px;cursor:pointer;transition:all .18s}
.chip:hover{color:var(--white);border-color:var(--amber2)}
.chip.on{background:var(--amber);border-color:var(--amber);color:var(--bg)}

/* ── station grid ── */
.station-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}
.station-card{position:relative;text-align:left;background:linear-gradient(180deg,rgba(30,24,18,.9),rgba(20,15,10,.92));border:1px solid var(--border);border-radius:12px;padding:22px 20px 18px;cursor:pointer;color:var(--white);font-family:var(--fb);overflow:hidden;transition:transform .2s,border-color .2s,box-shadow .2s}
.station-card:hover{transform:translateY(-5px);border-color:var(--ac);box-shadow:0 14px 34px rgba(0,0,0,.5),0 0 0 1px var(--ac)}
.station-card-bar{position:absolute;top:0;left:0;right:0;height:4px;background:var(--ac)}
.station-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.station-card-num{font-family:var(--fd);font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:11px;color:var(--dimmer)}
.tier-badge{font-family:var(--fd);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:10px;padding:3px 9px;border-radius:20px}
.station-card-name{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.01em;font-size:22px;line-height:1;margin-top:12px}
.station-card-tagline{color:var(--dim);font-size:13.5px;line-height:1.45;margin-top:8px;min-height:38px}
.station-card-skills{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.skill-pill{font-family:var(--fb);font-size:11px;color:var(--dim);background:rgba(255,255,255,.04);border:1px solid var(--border2);border-radius:20px;padding:3px 9px}
.skill-pill.meta{color:var(--amber2);border-color:rgba(232,150,10,.3)}
.station-card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:16px}
.plate-count{font-family:var(--fd);font-weight:700;font-size:13px;color:var(--dimmer)}
.pending-flag{display:block;margin-top:12px;font-family:var(--fd);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--dimmer);border-top:1px solid var(--border);padding-top:10px}
@media (max-width:820px){.station-grid{grid-template-columns:1fr 1fr;gap:12px}}
@media (max-width:560px){.station-grid{grid-template-columns:1fr}}

/* ── station screen ── */
.station-screen{max-width:720px;margin:0 auto}
.station-hero{text-align:center;padding:12px 0 8px}
.station-tier-badge{display:inline-block;font-family:var(--fd);font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-size:11px;padding:4px 12px;border-radius:20px}
.station-screen-num{font-family:var(--fd);font-weight:700;letter-spacing:.16em;text-transform:uppercase;font-size:12px;color:var(--dimmer);margin-top:14px}
.station-screen-name{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.01em;font-size:clamp(34px,6vw,52px);line-height:1}
.station-screen-tagline{color:var(--dim);font-size:16px;margin-top:10px}
.station-barbell-section{text-align:center;padding:26px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin:22px 0}
.barbell-label-row{display:flex;justify-content:center;gap:26px;margin-top:12px}
.barbell-label{font-family:var(--fd);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:12px}
.pr-rule{height:2px;width:120px;margin:14px auto 0;background:linear-gradient(90deg,transparent,currentColor,transparent);opacity:.5}
.pr-title{font-family:var(--fd);font-weight:900;letter-spacing:.16em;text-transform:uppercase;font-size:16px;margin-top:12px}
.pr-sub{color:var(--dim);font-size:14px;margin-top:6px}
.pr-section{text-align:center;margin-top:30px}
.station-intro p{color:rgba(242,239,232,.9);font-size:16.5px;line-height:1.7;margin-bottom:14px}
.everyday-box{background:rgba(232,150,10,.06);border:1px solid rgba(232,150,10,.2);border-radius:8px;padding:18px 20px;margin:8px 0 22px}
.everyday-label{font-family:var(--fd);font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:11px;color:var(--amber2);margin-bottom:8px}
.everyday-text{font-size:15.5px;line-height:1.6;color:rgba(242,239,232,.9)}
.beats-section{margin-bottom:26px}
.beats-title{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.06em;font-size:18px;margin-bottom:12px}
.beat-card{border-left:3px solid var(--border2);padding:4px 0 4px 16px;margin-bottom:14px}
.beat-move{font-family:var(--fd);font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:14px}
.beat-desc{color:var(--dim);font-size:14.5px;line-height:1.55;margin-top:4px}
.practice-section{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:24px;margin-bottom:24px}
.practice-label{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.08em;font-size:18px}
.rep-kind{font-family:var(--fd);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--dimmer);margin-top:6px}
.rep-kind.on{color:var(--amber2)}
.practice-prompt{font-size:16.5px;line-height:1.65;color:var(--white);margin:12px 0 16px}
.practice-hint{color:var(--dimmer);font-size:13.5px;font-style:italic;margin-bottom:10px}
.practice-textarea{width:100%;min-height:150px;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:var(--white);font-family:var(--fb);font-size:15px;line-height:1.6;padding:14px;resize:vertical}
.practice-textarea:focus{outline:none;border-color:var(--amber2)}
.attempt-label{font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--dim);margin-bottom:8px;margin-top:4px}
.reveal-hint{font-size:13px;color:var(--dimmer);font-style:italic;margin-top:10px}
.exemplar-box{background:var(--bg2);border:1px solid var(--border2);border-left:3px solid var(--amber2);border-radius:6px;padding:18px 20px;margin-top:14px}
.exemplar-header{font-family:var(--fd);font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-size:11px;color:var(--amber2);margin-bottom:10px}
.exemplar-text{font-size:15.5px;line-height:1.7;color:rgba(242,239,232,.92)}
.exemplar-note{font-size:13px;color:var(--dimmer);font-style:italic;margin-top:12px;border-top:1px solid var(--border);padding-top:12px}
.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:4px}
.attempt-readonly{background:var(--bg2);border:1px solid var(--border);border-radius:4px;padding:16px;font-size:15px;line-height:1.7;color:rgba(242,239,232,.62);white-space:pre-wrap;min-height:160px}
.compare-focus{background:rgba(193,119,0,.06);border:1px solid rgba(193,119,0,.22);border-radius:4px;padding:14px 16px;margin:14px 0}
.compare-focus-label{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--amber);margin-bottom:6px}
.compare-focus-text{font-size:15px;line-height:1.6;color:rgba(242,239,232,.85)}
@media (max-width:700px){.compare-grid{grid-template-columns:1fr}}
.mastery-section{margin-bottom:24px}
.mastery-title{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.06em;font-size:18px;margin-bottom:12px}
.mastery-item{display:flex;gap:12px;align-items:flex-start;padding:10px 0;cursor:pointer}
.mastery-checkbox{flex:none;width:24px;height:24px;border:2px solid var(--border2);border-radius:5px;display:flex;align-items:center;justify-content:center;margin-top:1px}
.mastery-check-icon{font-weight:900;font-size:14px}
.mastery-text{font-size:15px;line-height:1.55;color:rgba(242,239,232,.9)}
.mastery-text.done{color:var(--dimmer);text-decoration:line-through}
.exam-connection{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:20px 22px}
.exam-connection-label{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.08em;font-size:15px;margin-bottom:14px;color:var(--amber2)}
.exam-row{display:flex;gap:14px;padding:7px 0;border-bottom:1px solid var(--border);font-size:14.5px}
.exam-key{flex:none;width:120px;color:var(--dimmer);font-family:var(--fd);letter-spacing:.05em;text-transform:uppercase;font-size:12px;padding-top:2px}
.exam-val{color:rgba(242,239,232,.9);line-height:1.5}
.exam-missed{margin-top:14px;background:rgba(193,119,0,.06);border-radius:6px;padding:14px 16px}
.exam-missed-label{font-family:var(--fd);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:11px;color:var(--amber);margin-bottom:6px}
.exam-missed-text{font-size:14.5px;line-height:1.6;color:rgba(242,239,232,.85)}

/* ── stimulus (images-first) ── */
.stimulus-block{margin:8px 0 18px;display:flex;flex-direction:column;gap:14px}
.stimulus{border:1px solid var(--border2);border-radius:8px;overflow:hidden;background:#0c0a07;margin:0}
.stimulus img{display:block;width:100%;height:auto}
.stimulus figcaption{font-size:12.5px;color:var(--dim);padding:10px 14px;border-top:1px solid var(--border);font-style:italic}
.stimulus-text{padding:10px 14px;border-top:1px solid var(--border)}
.stimulus-text summary{font-family:var(--fd);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dimmer);cursor:pointer}
.stimulus-text p{font-size:14px;line-height:1.6;color:rgba(242,239,232,.82);margin-top:10px}

/* ── trainers ── */
.tools-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:24px}
.tool-card{background:linear-gradient(180deg,rgba(30,24,18,.9),rgba(20,15,10,.92));border:1px solid var(--border);border-left:3px solid var(--ac);border-radius:10px;padding:20px 22px}
.tool-num{font-family:var(--fd);font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-size:11px;color:var(--dimmer)}
.tool-name{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.01em;font-size:20px;margin-top:8px}
.tool-line{color:var(--dim);font-size:14px;margin-top:6px}
.tool-model{background:var(--bg2);border-radius:6px;padding:12px 14px;margin-top:12px;font-size:14.5px;line-height:1.6;color:rgba(242,239,232,.9)}
@media (max-width:700px){.tools-grid{grid-template-columns:1fr}}

/* ── recovery / empty state ── */
.empty-state{text-align:center;max-width:560px;margin:40px auto 0;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:44px 32px}
.empty-icon{opacity:.8;margin-bottom:16px}
.empty-title{font-family:var(--fd);font-weight:900;text-transform:uppercase;letter-spacing:.04em;font-size:22px}
.empty-text{color:var(--dim);font-size:15px;line-height:1.65;margin-top:12px}
.empty-text code{background:var(--bg2);border-radius:4px;padding:1px 6px;font-size:13px;color:var(--amber2)}
.empty-sub{color:var(--dimmer);font-size:14px;margin-top:14px}
.mc-list{margin-top:22px;display:flex;flex-direction:column;gap:22px}
.mc-item{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:22px}
.mc-q{font-size:16.5px;line-height:1.6;color:var(--white);margin:8px 0 14px;font-weight:500}
.mc-choice{display:block;width:100%;text-align:left;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;color:rgba(242,239,232,.9);font-family:var(--fb);font-size:15px;line-height:1.5;padding:13px 16px;margin-bottom:9px;cursor:pointer;transition:all .18s}
.mc-choice:hover:not(:disabled){border-color:var(--amber2)}
.mc-choice b{margin-right:8px;opacity:.7}
.mc-choice.correct{border-color:#43D982;background:rgba(67,217,130,.1);color:#9fe9bf}
.mc-choice.incorrect{border-color:#D65643;background:rgba(214,86,67,.1);color:#e9a99f}
.mc-choice.dim{opacity:.5}
.mc-reveal{margin-top:12px;border-top:1px solid var(--border);padding-top:14px}
.mc-verdict{font-family:var(--fd);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:12px;margin-bottom:8px}
.mc-verdict.ok{color:#43D982}.mc-verdict.no{color:#D65643}
.mc-reasoning{font-size:15px;line-height:1.6;color:rgba(242,239,232,.9)}
.mc-evidence,.mc-distractor{font-size:14px;line-height:1.6;color:var(--dim);margin-top:10px}
.mc-evidence b,.mc-distractor b{color:var(--amber2)}
`
