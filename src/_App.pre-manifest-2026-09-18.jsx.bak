// ============================================================
// THE ARENA — v1.1 shell  (thearena.flashpointhistory.com)
//
// A stateless-by-design skills trainer, framed by TR's "Man in the Arena."
// Reconstructed and wired from the delivered assets (the v1 React shell was
// reviewed off-repo and not included in the build package):
//   • arena-main-splash.html      → the frontdoor (TR greeter / quote / how-to)
//   • arena-landing-splash.html    → the rooms picker (Circuit / Trainer / Recovery)
//   • StationScreen.v1.1.jsx       → the multi-attempt COMPARE mechanic (below)
//   • content/station-01, -05 .json → real Regents reps, bound BY REFERENCE
//   • arena-mcset-schema-amendment.md → the Recovery Room mc_set contract
//
// LOCKED decisions honored here (BUILD-ORDER Step 2):
//   • Canvas = shared #16120E (not the prototype's #0D0B14); shared tokens.
//   • Sub-brand kept: Barlow Condensed / Outfit + amber. Not rebuilt in serif.
//   • Nothing depends on saved state — a wiped device lands on a full Arena.
// ============================================================

import { useState } from 'react'
import station01 from './content/station-01-contextualization.json'
import station05 from './content/station-05-sourcing-hipp.json'
import station08 from './content/station-08-argument-development.json'
import station09 from './content/station-09-paragraph-construction.json'
import station11 from './content/station-11-civic-literacy.json'

const ARENA_QUOTE = {
  text: 'The credit belongs to the man who is actually in the arena… who spends himself in a worthy cause.',
  cite: 'Theodore Roosevelt · The Sorbonne · 1910',
}
const HOME_URL = 'https://flashpointhistory.com'

// ── The six CLE Skill Growth Map skills (handoff §4 crosswalk) ─────────────
const SKILLS = {
  1: 'Historical Context',
  2: 'Thesis',
  3: 'Document Use',
  4: 'Explanation',
  5: 'Outside Evidence',
  6: 'Civic Principle',
}

// ── Four tiers of the Circuit (barbell weight classes) ─────────────────────
const TIERS = {
  Foundation: { label: 'Foundation', color: '#E8960A' },
  Evidence:   { label: 'Evidence',   color: '#6BA5B8' },
  Argument:   { label: 'Argument',   color: '#43D982' },
  Mastery:    { label: 'Mastery',    color: '#B07CD0' },
}
const PLATES = ['Name it', 'Link it', 'Land it']

// ── Bind a curriculum-owned content package onto a shell station ───────────
// The Circuit points AT content (handoff: "binding by reference"); the shell
// never absorbs it. rep1 is the everyday on-ramp (stays in the shell); rep2 is
// the real Regents rep that drops in from the audited package.
function boundRep(pkg) {
  // Latest regents rep wins: where the shell renders a single rep, the most
  // recent administration (June 2026) takes precedence for the August sprint.
  const regents = (pkg.reps || []).filter(r => r.type === 'regents')
  return regents.length ? regents[regents.length - 1] : null
}

const s01 = boundRep(station01)
const s05 = boundRep(station05)
const s08 = boundRep(station08)
const s09 = boundRep(station09)
const s11 = boundRep(station11)

// ── The 12-station Circuit (the genesis shell; nothing hard-coded) ─────────
// Stations I and V are BOUND to delivered packages. The other ten ship with
// their everyday on-ramp rep and flag `pending` — their Regents drill bank
// loads the moment that unit is audited (handoff §6, queue item 5).
